# Copy to .env and adjust.  .env is gitignored; .env.example is not, so never
# put anything secret (an API token, in particular) in either -- see
# docs/cluster.md.
#
# These are for Python code and notebooks.  Batch jobs get their environment
# from env.sh, which is the authoritative version; keep the two consistent.

# Small, committed inputs and notes live in the repo.  The real dataset does
# not -- see data/README.md.
DATA_DIR=./data/

# Shared project allocation on the DSI cluster.
FERMI_PROJECT_DIR=/net/projects2/fermi2526

# NuGraph's three-variable contract.  Leave NUGRAPH_DIR unset to use the
# external/nugraph submodule in this repo, which is almost always what you want.
# NUGRAPH_DIR=
NUGRAPH_DATA=/net/projects2/fermi2526/data
# NUGRAPH_LOG defaults to $FERMI_PROJECT_DIR/logs/$USER
# NUGRAPH_LOG=
